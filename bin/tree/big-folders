#!/usr/bin/env zsh
# ---------------------------------------------
# big-folders.sh
#
# Uso:
#   big-folders.sh
#   big-folders.sh 20
#   big-folders.sh path
#   big-folders.sh path 30
#   big-folders.sh -I tmp -I vendor path 30
#
# ---------------------------------------------

set -euo pipefail

# ---------------------------------------------
# Defaults
# ---------------------------------------------
ROOT="$PWD"
MAX_ITEMS=20
TREE_DEPTH=4

STATIC_IGNORES=(
  node_modules
  ios/Pods
  .git
)

USER_IGNORES=()

# ---------------------------------------------
# Argument parsing
# ---------------------------------------------
ARGS=("$@")
i=1

while (( i <= $# )); do
  arg="${ARGS[i]}"

  case "$arg" in
    -I)
      (( i++ ))
      [[ -z "${ARGS[i]:-}" ]] && {
        echo "Error: -I requiere un argumento" >&2
        exit 1
      }
      USER_IGNORES+=("${ARGS[i]}")
      ;;
    *)
      if [[ -d "$arg" ]]; then
        ROOT="$(cd "$arg" && pwd)"
      elif [[ "$arg" =~ '^[0-9]+$' ]]; then
        MAX_ITEMS="$arg"
      else
        echo "Error: argumento no reconocido: $arg" >&2
        exit 1
      fi
      ;;
  esac

  (( i++ ))
done

# ---------------------------------------------
# Normalizar ignores de usuario (rutas relativas)
# ---------------------------------------------
NORMALIZED_USER_IGNORES=()

for p in "${USER_IGNORES[@]}"; do
  p="${p#./}"
  NORMALIZED_USER_IGNORES+=("$p")
done

# ---------------------------------------------
# 1. Detectar carpetas grandes (nivel 1)
# ---------------------------------------------
BIG_DIRS=()

while IFS= read -r -d '' dir; do
  count=$(find "$dir" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')
  if (( count > MAX_ITEMS )); then
    BIG_DIRS+=("$(basename "$dir")")
  fi
done < <(find "$ROOT" -mindepth 1 -maxdepth 1 -type d -print0)

# ---------------------------------------------
# 2. Construir exclusiones para tree
# ---------------------------------------------
IGNORE_PATTERN=$(printf "|%s" \
  "${STATIC_IGNORES[@]}" \
  "${NORMALIZED_USER_IGNORES[@]}" \
  "${BIG_DIRS[@]}"
)

IGNORE_PATTERN="${IGNORE_PATTERN:1}"

# ---------------------------------------------
# 3. Tree visual
# ---------------------------------------------
tree -L "$TREE_DEPTH" -I "$IGNORE_PATTERN" "$ROOT"

echo
echo "---- resumen (objetos directos por carpeta) ----"

# ---------------------------------------------
# 4. Resumen final
# ---------------------------------------------
find "$ROOT" -mindepth 1 -maxdepth 1 -type d -exec sh -c '
  for d; do
    printf "%4d  %s\n" "$(find "$d" -mindepth 1 -maxdepth 1 | wc -l)" "$(basename "$d")"
  done
' sh {} + | sort -nr
