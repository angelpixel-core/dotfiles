#!/usr/bin/env zsh
# ---------------------------------------------
# big-folders.sh
#
# Uso:
#   big-folders.sh
#   big-folders.sh 20
#   big-folders.sh path
#   big-folders.sh path 30
#
# ---------------------------------------------

set -euo pipefail

# ---------------------------------------------
# Defaults
# ---------------------------------------------
ROOT="$PWD"
MAX_ITEMS=20
TREE_DEPTH=4

# ---------------------------------------------
# Argument parsing
# ---------------------------------------------
if [[ $# -ge 1 ]]; then
  if [[ -d "$1" ]]; then
    ROOT="$(cd "$1" && pwd)"
    [[ $# -ge 2 ]] && MAX_ITEMS="$2"
  elif [[ "$1" =~ '^[0-9]+$' ]]; then
    MAX_ITEMS="$1"
  else
    echo "Error: '$1' no es un directorio ni un número válido" >&2
    exit 1
  fi
fi

# ---------------------------------------------
# Carpetas siempre ignoradas
# ---------------------------------------------
STATIC_IGNORES=(
  node_modules
  ios/Pods
  .git
)

# ---------------------------------------------
# 1. Detectar carpetas grandes (nivel 1)
# ---------------------------------------------
BIG_DIRS=()

while IFS= read -r -d '' dir; do
  count=$(find "$dir" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')
  if (( count > MAX_ITEMS )); then
    BIG_DIRS+=("$(basename "$dir")")
  fi
done < <(find "$ROOT" -mindepth 1 -maxdepth 1 -type d -print0)

# ---------------------------------------------
# 2. Construir exclusiones para tree
# ---------------------------------------------
IGNORE_PATTERN=$(printf "|%s" "${STATIC_IGNORES[@]}" "${BIG_DIRS[@]}")
IGNORE_PATTERN="${IGNORE_PATTERN:1}"

# ---------------------------------------------
# 3. Tree visual
#   - sin -d (mostrar archivos)
#   - profundidad controlada
#   - exclusión dinámica de carpetas grandes
# ---------------------------------------------
tree -L "$TREE_DEPTH" -I "$IGNORE_PATTERN" "$ROOT"

echo
echo "---- resumen (objetos directos por carpeta) ----"

# ---------------------------------------------
# 4. Resumen final
# ---------------------------------------------
find "$ROOT" -mindepth 1 -maxdepth 1 -type d -exec sh -c '
  for d; do
    printf "%4d  %s\n" "$(find "$d" -mindepth 1 -maxdepth 1 | wc -l)" "$(basename "$d")"
  done
' sh {} + | sort -nr

