#!/usr/bin/env bash

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$DOTFILES_ROOT/lib/common.sh"

quick_mode=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quick)
      quick_mode=true
      shift
      ;;
    *)
      log_error "Argumento no soportado: $1"
      log_info "Uso: analyze_dotfiles [--quick]"
      exit 1
      ;;
  esac
done

failures=0

run_step() {
  local label="$1"
  shift

  log_step "$label"
  if "$@"; then
    log_success "$label: OK"
  else
    log_error "$label: ERROR"
    failures=$((failures + 1))
  fi
}

log_info "Analizando estado del repositorio de dotfiles..."

run_step "Dependencias bootstrap" "$DOTFILES_ROOT/scripts/bootstrap/check-deps.sh"
run_step "Smoke tests" "$DOTFILES_ROOT/scripts/tests/run.sh"

if [[ "$quick_mode" == false ]]; then
  run_step "Secret scan" "$DOTFILES_ROOT/scripts/security/scan-secrets.sh"
else
  log_warning "Modo rapido activo: se omite secret scan"
fi

log_step "Estado git"
git -C "$DOTFILES_ROOT" status --short --branch

if (( failures > 0 )); then
  log_error "Analisis finalizado con $failures error(es)"
  exit 1
fi

log_success "Analisis finalizado sin errores"
