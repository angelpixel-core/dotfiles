[submodule "terminal/alacritty/themes"]
	path = terminal/alacritty/themes
	url = https://github.com/alacritty/alacritty-theme.git
[submodule "shell/functions/system-monitor"]
	path = shell/functions/system-monitor
	url = ./shell/functions/system-monitor
[submodule "terminal/wezterm"]
	path = terminal/wezterm
	url = ./terminal/wezterm
[submodule "editors/nvim"]
	path = editors/nvim
	url = https://github.com/angel-devstack/nvim.git
[submodule "shell/zsh/.zim/modules/completion"]
	path = shell/zsh/.zim/modules/completion
	url = https://github.com/zimfw/completion.git
[submodule "shell/zsh/.zim/modules/environment"]
	path = shell/zsh/.zim/modules/environment
	url = https://github.com/zimfw/environment.git
[submodule "shell/zsh/.zim/modules/input"]
	path = shell/zsh/.zim/modules/input
	url = https://github.com/zimfw/input.git
[submodule "shell/zsh/.zim/modules/spaceship"]
	path = shell/zsh/.zim/modules/spaceship
	url = https://github.com/spaceship-prompt/spaceship-prompt.git
[submodule "shell/zsh/.zim/modules/zsh-autosuggestions"]
	path = shell/zsh/.zim/modules/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions.git
[submodule "shell/zsh/.zim/modules/zsh-syntax-highlighting"]
	path = shell/zsh/.zim/modules/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
