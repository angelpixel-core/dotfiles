# Copia este archivo a env/.env.local y completa valores reales.
# NUNCA subas env/.env.local al repositorio.

# API keys (ejemplos)
MXBAI_API_KEY=""

# Opcional: URI de 1Password para resolver MXBAI_API_KEY automaticamente
# Formato esperado: op://<Vault>/<Item>/<Field>
MXBAI_API_KEY_OP_URI=""

# Puedes definir otras variables sensibles usadas en tu entorno:
